{
  "name": "nationstates/game-php",
  "description": "A NationStates-like strategy game built with PHP 8.3",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "slim/slim": "^4.13",
    "slim/psr7": "^1.7",
    "doctrine/orm": "^2.16",
    "php-di/php-di": "^7.0",
    "monolog/monolog": "^3.4",
    "vlucas/phpdotenv": "^5.6",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "NationStates\\": "src/"
    }
  }
}
